# ==============================================================================
# MESHVI FRONTEND (Vite / React) ENVIRONMENT TEMPLATE (.env.example)
# All client-side env variables MUST be prefixed with VITE_
# ==============================================================================

# Backend API Endpoint
VITE_API_URL=https://api.meshvi.org/api/v1
VITE_BACKEND_URL=https://api.meshvi.org

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# LinkedIn OAuth 2.0 Client ID & Redirect URI
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
VITE_LINKEDIN_REDIRECT_URI=https://meshvi.org/auth/linkedin/callback
