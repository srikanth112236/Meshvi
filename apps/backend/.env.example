# ==============================================================================
# MESHVI BACKEND (NestJS) ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3500
BACKEND_PORT=3500

# Client Origins & CORS
FRONTEND_URL=https://meshvi-1.onrender.com
CORS_ORIGIN=https://meshvi-1.onrender.com
API_BASE_URL=https://meshvi.onrender.com/api/v1
LAN_IP=192.168.1.6

# PostgreSQL Database (schema: project_setu)
DATABASE_URL="postgresql://username:password@localhost:5432/leadcrm?schema=project_setu"

# Authentication Security (Min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here!
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_random_hash_here!

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://meshvi-1.onrender.com/auth/google/callback

# LinkedIn OAuth 2.0 / OpenID Connect
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://meshvi-1.onrender.com/auth/linkedin/callback
LINKEDIN_CALLBACK_URL=https://meshvi.onrender.com/api/v1/auth/linkedin/callback
LINKEDIN_OAUTH_SCOPE=openid profile email w_member_social

# Google Gemini AI Intent Parsing Engine
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_MODEL=zen-v1
AI_REQUEST_TIMEOUT_MS=10000
AI_MAX_RETRIES=2

# Real-Time SMTP Email Dispatch
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM_ADDRESS="MESHVI Security <no-reply@meshvi.com>"

# Media & Document Upload Limit (50MB)
UPLOAD_MAX_BYTES=52428800
