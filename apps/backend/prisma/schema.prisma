// --- F1: Partnership Readiness Signal ---
enum ReadinessStatus {
  OPEN
  SELECTIVE
  STEALTH
  PAUSED
}

model PartnershipReadiness {
  id                  String          @id @default(uuid())
  profileId           String?         @unique @map("profile_id")
  companyId           String?         @unique @map("company_id")
  status              ReadinessStatus @default(OPEN)
  activeSectors       String?         @map("active_sectors")    // JSON array of sector tags
  activeGeographies   String?         @map("active_geographies") // JSON array of geo codes
  partnershipTypes    String?         @map("partnership_types")  // JSON array: DISTRIBUTION, SUPPLIER, JOINT_VENTURE, etc.
  notLookingFor       String?         @map("not_looking_for")   // JSON array of exclusions
  openMessage         String?         @map("open_message")      // Short public-facing welcome note
  lastRespondedAt     DateTime?       @map("last_responded_at")
  refreshedAt         DateTime        @default(now()) @map("refreshed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  profile             ProfessionalProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("partnership_readiness")
}

// --- F3: "Why Now" Trigger Intelligence ---
enum TriggerType {
  NEWS
  HIRING_SIGNAL
  USER_DECLARED
  FUNDING_EVENT
  PRODUCT_LAUNCH
  EXPANSION_SIGNAL
}

model TriggerSignal {
  id             String      @id @default(uuid())
  companyId      String      @map("company_id")
  triggerType    TriggerType @default(NEWS)
  headline       String
  body           String?
  sourceUrl      String?     @map("source_url")
  relevanceScore Float       @default(0.5) @map("relevance_score")
  isVerified     Boolean     @default(false) @map("is_verified")
  expiresAt      DateTime?   @map("expires_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, triggerType])
  @@index([expiresAt])
  @@map("trigger_signals")
}

// --- F4: Setu Deal Room ---
enum DealRoomStatus {
  ACTIVE
  PAUSED
  CLOSED_WON
  CLOSED_NOT_FIT
  PARKED
}

enum DealOutcomeType {
  EXPLORATORY_CALL
  DEMO_COMPLETED
  MOU_SIGNED
  DEAL_CLOSED
  NOT_A_FIT
  PARKED
}

model DealRoom {
  id                 String          @id @default(uuid())
  connectionId       String          @unique @map("connection_id")
  initiatorUserId    String          @map("initiator_user_id")
  partnerUserId      String          @map("partner_user_id")
  title              String
  initiatorGoal      String?         @map("initiator_goal")
  partnerGoal        String?         @map("partner_goal")
  status             DealRoomStatus  @default(ACTIVE)
  ndaRequired        Boolean         @default(false) @map("nda_required")
  closedAt           DateTime?       @map("closed_at")
  closedOutcome      DealOutcomeType? @map("closed_outcome")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  milestones         DealRoomMilestone[]
  documents          DealRoomDocument[]
  outcome            PartnershipOutcome?

  @@index([initiatorUserId])
  @@index([partnerUserId])
  @@map("deal_rooms")
}

model DealRoomMilestone {
  id           String    @id @default(uuid())
  dealRoomId   String    @map("deal_room_id")
  title        String
  description  String?
  dueDate      DateTime? @map("due_date")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  assignedTo   String?   @map("assigned_to") // userId
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  dealRoom     DealRoom  @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)

  @@index([dealRoomId])
  @@map("deal_room_milestones")
}

model DealRoomDocument {
  id            String    @id @default(uuid())
  dealRoomId    String    @map("deal_room_id")
  uploadedByUserId String @map("uploaded_by_user_id")
  name          String
  fileUrl       String    @map("file_url")
  fileType      String?   @map("file_type")
  sizeBytes     Int?      @map("size_bytes")
  createdAt     DateTime  @default(now()) @map("created_at")

  dealRoom      DealRoom  @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)

  @@index([dealRoomId])
  @@map("deal_room_documents")
}

// --- F5: Outcome-Based Reputation Engine ---
model PartnershipOutcome {
  id                    String          @id @default(uuid())
  dealRoomId            String          @unique @map("deal_room_id")
  outcomeType           DealOutcomeType @map("outcome_type")
  partnershipCategory   String?         @map("partnership_category") // DISTRIBUTION, SUPPLIER, JOINT_VENTURE, etc.
  geographyTag          String?         @map("geography_tag")
  dealValue             Float?          @map("deal_value")
  initiatorRating       Int?            @map("initiator_rating")    // 1-5
  partnerRating         Int?            @map("partner_rating")      // 1-5
  initiatorFeedback     String?         @map("initiator_feedback")
  partnerFeedback       String?         @map("partner_feedback")
  initiatorSubmittedAt  DateTime?       @map("initiator_submitted_at")
  partnerSubmittedAt    DateTime?       @map("partner_submitted_at")
  isDisputed            Boolean         @default(false) @map("is_disputed")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  dealRoom              DealRoom        @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)

  @@map("partnership_outcomes")
}

model ReputationScore {
  id                     String    @id @default(uuid())
  profileId              String    @unique @map("profile_id")
  totalDeals             Int       @default(0) @map("total_deals")
  closedWonCount         Int       @default(0) @map("closed_won_count")
  averageRatingReceived  Float     @default(0) @map("average_rating_received")
  responsivenessScore    Float     @default(0) @map("responsiveness_score")
  topCategories          String?   @map("top_categories")   // JSON array
  topGeographies         String?   @map("top_geographies")  // JSON array
  lastComputedAt         DateTime  @default(now()) @map("last_computed_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  profile                ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("reputation_scores")
}

// ==========================================
// GAP 1: MUTUAL OPPORTUNITY MATCHING MODELS
// ==========================================

enum OpportunityOwnerType {
  COMPANY
  PROFESSIONAL
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OpportunityVisibility {
  DISCOVERABLE
  PRIVATE
}

enum OpportunityMatchLevel {
  MUTUAL_INTENT
  POTENTIAL_FIT
  NOT_ELIGIBLE
}

enum OpportunityRequestStatus {
  PENDING
  CLARIFICATION_REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model OpportunityProfile {
  id               String                 @id @default(uuid())
  ownerType        OpportunityOwnerType   @default(PROFESSIONAL) @map("owner_type")
  companyId        String?                @map("company_id")
  profileId        String?                @map("profile_id")
  createdById      String                 @map("created_by_id")
  title            String
  summary          String?
  status           OpportunityStatus      @default(DRAFT)
  visibility       OpportunityVisibility  @default(DISCOVERABLE)
  approvalMode     String                 @default("MANUAL") @map("approval_mode")
  targetIndustries String?                @map("target_industries")   // JSON array
  targetMarkets    String?                @map("target_markets")      // JSON array
  partnerTypes     String?                @map("partner_types")       // JSON array
  startsAt         DateTime?              @map("starts_at")
  expiresAt        DateTime?              @map("expires_at")
  publishedAt      DateTime?              @map("published_at")
  pausedAt         DateTime?              @map("paused_at")
  archivedAt       DateTime?              @map("archived_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  company          Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile          ProfessionalProfile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  requirements     OpportunityRequirement[]
  offers           OpportunityOffer[]

  sourceMatches    OpportunityMatch[]     @relation("SourceOpportunity")
  targetMatches    OpportunityMatch[]     @relation("TargetOpportunity")

  sentRequests     OpportunityRequest[]   @relation("SenderOpportunity")
  receivedRequests OpportunityRequest[]   @relation("RecipientOpportunity")

  events           OpportunityEvent[]

  @@index([ownerType, status, visibility])
  @@index([companyId])
  @@index([profileId])
  @@map("opportunity_profiles")
}

model OpportunityRequirement {
  id                    String              @id @default(uuid())
  opportunityProfileId  String              @map("opportunity_profile_id")
  businessObjective     String              @map("business_objective") // e.g. "distribution_partnership", "contract_manufacturing"
  partnerType           String?             @map("partner_type")       // e.g. "airport_concessionaire", "regional_distributor"
  industries            String?             // JSON array e.g. ["beverages", "hospitality"]
  geographies           String?             // JSON array e.g. ["MY", "SG", "TH"]
  description           String?
  createdAt             DateTime            @default(now()) @map("created_at")

  opportunityProfile    OpportunityProfile  @relation(fields: [opportunityProfileId], references: [id], onDelete: Cascade)

  @@index([opportunityProfileId])
  @@map("opportunity_requirements")
}

model OpportunityOffer {
  id                    String              @id @default(uuid())
  opportunityProfileId  String              @map("opportunity_profile_id")
  capability            String              // e.g. "hospitality_distribution", "organic_beverage_supply"
  productsServices      String?             @map("products_services") // description/tags
  marketAccess          String?             @map("market_access")     // e.g. "Changi T3 & T4 Lounges"
  geographies           String?             // JSON array e.g. ["MY", "SG", "TH"]
  createdAt             DateTime            @default(now()) @map("created_at")

  opportunityProfile    OpportunityProfile  @relation(fields: [opportunityProfileId], references: [id], onDelete: Cascade)

  @@index([opportunityProfileId])
  @@map("opportunity_offers")
}

model OpportunityMatch {
  id                    String                @id @default(uuid())
  sourceOpportunityId   String                @map("source_opportunity_id")
  targetOpportunityId   String                @map("target_opportunity_id")
  matchLevel            OpportunityMatchLevel @default(POTENTIAL_FIT) @map("match_level")
  score                 Float                 @default(0)
  evidenceJson          String                @map("evidence_json") // JSON with overlap details
  whyMatches            String                @map("why_matches")   // Human readable explanation
  status                String                @default("ACTIVE")
  lastEvaluatedAt       DateTime              @default(now()) @map("last_evaluated_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  sourceOpportunity     OpportunityProfile    @relation("SourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: Cascade)
  targetOpportunity     OpportunityProfile    @relation("TargetOpportunity", fields: [targetOpportunityId], references: [id], onDelete: Cascade)

  requests              OpportunityRequest[]

  @@unique([sourceOpportunityId, targetOpportunityId])
  @@index([sourceOpportunityId, matchLevel])
  @@index([targetOpportunityId, matchLevel])
  @@map("opportunity_matches")
}

model OpportunityRequest {
  id                    String                    @id @default(uuid())
  opportunityMatchId    String?                   @map("opportunity_match_id")
  senderOpportunityId   String                    @map("sender_opportunity_id")
  recipientOpportunityId String                   @map("recipient_opportunity_id")
  senderUserId          String                    @map("sender_user_id")
  recipientUserId       String                    @map("recipient_user_id")
  message               String
  status                OpportunityRequestStatus  @default(PENDING)
  clarificationQuestion String?                   @map("clarification_question")
  clarificationAnswer   String?                   @map("clarification_answer")
  decisionReason        String?                   @map("decision_reason")
  connectionId          String?                   @map("connection_id")
  dealRoomId            String?                   @map("deal_room_id")
  respondedAt           DateTime?                 @map("responded_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  match                 OpportunityMatch?         @relation(fields: [opportunityMatchId], references: [id], onDelete: SetNull)
  senderOpportunity     OpportunityProfile        @relation("SenderOpportunity", fields: [senderOpportunityId], references: [id], onDelete: Cascade)
  recipientOpportunity   OpportunityProfile        @relation("RecipientOpportunity", fields: [recipientOpportunityId], references: [id], onDelete: Cascade)
  senderUser            User                      @relation("SenderUser", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUser          User                      @relation("RecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status])
  @@index([senderUserId, status])
  @@map("opportunity_requests")
}

model OpportunityEvent {
  id                    String              @id @default(uuid())
  opportunityProfileId  String              @map("opportunity_profile_id")
  userId                String              @map("user_id")
  eventType             String              @map("event_type") // CREATED, PUBLISHED, PAUSED, ARCHIVED, REQUEST_SENT, REQUEST_ACCEPTED, etc.
  detailsJson           String?             @map("details_json")
  createdAt             DateTime            @default(now()) @map("created_at")

  opportunityProfile    OpportunityProfile  @relation(fields: [opportunityProfileId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityProfileId, eventType])
  @@map("opportunity_events")
}
