# ==============================================================================
# MESHVI MOBILE (React Native / Expo) ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env and fill in your values
# All public mobile variables MUST be prefixed with EXPO_PUBLIC_
# ==============================================================================

# Backend Network Connection (Use your computer's LAN IP for Wi-Fi testing)
EXPO_PUBLIC_BACKEND_IP=192.168.1.6
EXPO_PUBLIC_BACKEND_PORT=3500
EXPO_PUBLIC_API_URL=http://192.168.1.6:3500/api/v1

# Google OAuth 2.0 Credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# LinkedIn Integration
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
