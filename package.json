{
  "name": "project-setu",
  "version": "1.0.0",
  "private": true,
  "description": "Project Setu - Intent-driven B2B professional & business connection platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "cd apps/backend && npx prisma db push --skip-generate --accept-data-loss && node dist/main",
    "dev:backend": "npm run start:dev --workspace=@setu/backend",
    "dev:frontend": "npm run dev --workspace=@setu/frontend",
    "dev:mobile": "npm run start --workspace=@setu/mobile",
    "seed": "npm run seed --workspace=@setu/backend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:flow": "ts-node --project apps/backend/tsconfig.json scripts/test-connections-flow.ts",
    "lint": "npm run lint --workspaces",
    "mobile:build:dev": "npm run build:dev:android --workspace=@setu/mobile",
    "mobile:build:preview": "npm run build:preview:android --workspace=@setu/mobile",
    "mobile:build:apk": "npm run build:apk:android --workspace=@setu/mobile",
    "mobile:build:prod": "npm run build:prod:android --workspace=@setu/mobile"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  },
  "keywords": [
    "b2b",
    "networking",
    "business-discovery"
  ],
  "author": "Vedasynk Technologies",
  "license": "UNLICENSED"
}
