{
  "name": "project-setu",
  "version": "1.0.0",
  "private": true,
  "description": "Project Setu - Intent-driven B2B professional & business connection platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=apps/backend/prisma/schema.prisma",
    "dev:backend": "npm run start:dev --workspace=@setu/backend",
    "dev:frontend": "npm run dev --workspace=@setu/frontend",
    "dev:mobile": "npm run start --workspace=@setu/mobile",
    "seed": "npm run seed --workspace=@setu/backend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:flow": "ts-node --project apps/backend/tsconfig.json scripts/test-connections-flow.ts",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "keywords": [
    "b2b",
    "networking",
    "business-discovery"
  ],
  "author": "Vedasynk Technologies",
  "license": "UNLICENSED"
}
